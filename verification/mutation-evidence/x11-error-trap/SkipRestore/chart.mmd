---
title: "Install, drain, and restore the capture error handler"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: finished
    lg1: in progress
    lg2: Breaks RestoredHandler
    lg3: Path to the RestoredHandler bug
  }
  class lg0 teal
  class lg1 blue
  class lg2 breaks
  class lg3 bugPath
  s0: Previous handler active
  s1: Capture context published
  s2: Capture handler active
  s3: First capture error retained
  s4: Requests drained
  s5: Capture handler left installed
  s6: Handler points at cleared context
  [*] --> s0
  s0 --> s1: publish capture context
  s1 --> s2: install capture handler
  s2 --> s3: capture request fails
  s2 --> s4: finish pending requests
  s3 --> s4: finish pending requests
  s4 --> s5: skip restoring the handler
  s5 --> s6: clear capture context
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  class s0 blue
  class s0 bugPath
  class s1 blue
  class s1 bugPath
  class s2 blue
  class s2 bugPath
  class s3 blue
  class s4 blue
  class s4 bugPath
  class s5 blue
  class s5 bugPath
  class s6 teal
  class s6 breaks
  class s6 bugPath
