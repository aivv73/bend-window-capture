---
title: "Capture a window, close it, then read its pixels"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: in progress
    lg1: failed
    lg2: Breaks ReportAfterClose
    lg3: Path to the ReportAfterClose bug
  }
  class lg0 blue
  class lg1 orange
  class lg2 breaks
  class lg3 bugPath
  s0: Opening a window
  s1: Window could not open
  s2: Window open
  s3: Image drawn
  s4: Snapshot ready
  s5: Capture failed
  s6: Reporting while the window remains open
  s7: Reported without closing the window
  [*] --> s0
  s0 --> s1: opening fails
  s0 --> s2: window opens
  s2 --> s3: draw the image
  s3 --> s4: capture succeeds
  s3 --> s5: capture fails
  s4 --> s6: continue without closing the window
  s5 --> s6: continue without closing the window
  s6 --> s7: print captured pixels or report the capture error
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  class s0 blue
  class s0 bugPath
  class s1 orange
  class s2 blue
  class s2 bugPath
  class s3 blue
  class s3 bugPath
  class s4 blue
  class s4 bugPath
  class s5 blue
  class s6 blue
  class s6 breaks
  class s6 bugPath
  class s7 breaks
